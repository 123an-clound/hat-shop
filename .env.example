# Local mode works without Supabase. Generate a password hash using npm run setup:admin.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD_HASH=
# Set these only after applying database/urban_caps.sql to the selected Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to the real HTTPS domain before indexing/deployment.
NEXT_PUBLIC_SITE_URL=
